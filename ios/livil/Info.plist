<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Livil</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.livil</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>livil</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>instagram</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Export compliance. Declared once here so App Store Connect stops asking
	     on every upload. false is correct: the app ships no crypto library, does
	     no encryption of its own, and talks only HTTPS (NSAllowsArbitraryLoads is
	     false above) - i.e. it uses nothing beyond the standard encryption iOS
	     itself provides, which is exempt. Revisit this if we ever add our own
	     cryptography or ship a non-standard algorithm. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Livil uses the camera so you can take a new photo for your profile picture or an album cover.</string>
	<!-- Record → Magic Tune → Editor (ADR-0036 §8): the mic is requested on the first Record
	     tap in the Editor (studioEngine.ts, AudioManager.requestRecordingPermissions) and
	     nowhere else. Until 2.2.0 nothing recorded and this string said so; it was still
	     required then (ITMS-90683 rejected 2.0.6 (71) without it, because the linked
	     react-native-audio-api references the API). Names the one use, per 5.1.1(ii). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Livil uses the microphone only while you are recording a song in the Editor. Nothing is uploaded unless you choose to post it.</string>
	<!-- Names EVERY use, per guideline 5.1.1(ii): the gallery is opened for a profile
	     picture (profileService), album and track cover art (albums, mediaPicks), and a
	     video to upload with its thumbnail (mediaPicks.pickVideoFromGallery). The old text
	     named only the first two. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Livil needs access to your photos so you can pick a profile picture, cover art for your music, or a video to upload.</string>
	<!-- Add-only (LivilChatMedia.m saveToPhotos): asked the first time someone taps Save on a
	     photo sent to them in chat. Livil can add that photo; it never reads the library. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Livil saves a photo to your library only when you tap Save on a photo someone sent you in a chat.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Anton-Regular.ttf</string>
		<string>CourierPrime-Bold.ttf</string>
		<string>CourierPrime-Regular.ttf</string>
	</array>
	<!-- Scene lifecycle. REQUIRED by the iOS 27 SDK: an app built with Xcode 27 that
	     has no scene manifest is killed by UIKit at launch
	     (_UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption -> brk 0),
	     before a single line of our code runs. App Review rejected 2.1.0 (74) for
	     exactly that; builds 71-73 were fine only because they were compiled with
	     Xcode 26.5. The window is created by SceneDelegate.swift, not by
	     RCTAppDelegate (see automaticallyLoadReactNativeWindow in AppDelegate.swift).
	     One scene only: multi-window is neither wanted nor supported by the single
	     playback engine. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- RESERVED, AND INERT TODAY. send-push sends a standard alert payload — `aps`
		     carries alert/sound/thread-id and NO `content-available: 1` — which iOS renders
		     itself. This background mode is only consulted for silent wakes, so nothing
		     currently uses it.

		     THE TRAP IF THAT CHANGES: add `content-available: 1` to that aps block and
		     setBackgroundMessageHandler fires AND iOS renders aps.alert — two cards for one
		     notification. Same shape as the MediaSession carousel. Either send data-only
		     (no alert) or keep the alert and no content-available; never both.

		     `audio` is unrelated and stays: it keeps playback alive on the lock screen. -->
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
