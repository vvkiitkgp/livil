# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'livil' do
  config = use_native_modules!

  # Firebase (push notifications) ships FirebaseCoreInternal as a Swift pod, and Swift can
  # only import a static library that defines a module map. GoogleUtilities — which it
  # depends on — does not define one by default, so `pod install` aborts with
  # "The following Swift pods cannot yet be integrated as static libraries".
  #
  # Fixed narrowly rather than with a global `use_modular_headers!` or
  # `use_frameworks! :linkage => :static`: both change how EVERY pod is built, which on
  # RN 0.85 + Hermes + the New Architecture is a much larger blast radius than this one
  # dependency warrants.
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode refuses pod targets whose iOS deployment target is below its supported
    # range, and several pods (and their privacy resource bundles) still declare
    # 8.0–13.4 — the build failed with nine "IPHONEOS_DEPLOYMENT_TARGET is set to 8.0,
    # but the range..." errors. Lift them all to the app's own minimum (15.1, as in
    # livil.xcodeproj), which changes nothing at runtime: the app already requires it.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        if cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  end
end
