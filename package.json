{
  "name": "livil",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start:android": "npx react-native run-android",
    "test": "jest",
    "prebuild:android": "node -e \"const fs=require('fs'),p='android/app/build.gradle',g=fs.readFileSync(p,'utf8');let n=g.replace(/versionCode (\\d+)/,(m,c)=>'versionCode '+(+c+1)).replace(/versionName \\\"(\\d+\\.\\d+\\.)(\\d+)\\\"/,(m,pre,patch)=>'versionName \\\"'+pre+(+patch+1)+'\\\"');fs.writeFileSync(p,n);console.log(n.match(/versionCode \\d+/)[0],n.match(/versionName \\\"[^\\\"]+\\\"/)[0])\"",
    "build:android": "cd android && ./gradlew bundleRelease && cd .."
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-documents/picker": "^10.1.7",
    "@react-native-firebase/app": "^24.1.0",
    "@react-native-firebase/messaging": "^24.1.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.15.10",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@react-navigation/stack": "^7.8.11",
    "@supabase/supabase-js": "^2.99.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-reanimated": "^4.4.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.11.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-video": "^6.19.2",
    "react-native-worklets": "^0.9.0",
    "text-encoding-polyfill": "^0.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
