+package com.reactnativecompressor.Audio
+
+import android.media.AudioFormat
+import android.media.MediaCodec
+import android.media.MediaCodecInfo
+import android.media.MediaExtractor
+import android.media.MediaFormat
+import android.media.MediaMuxer
+import android.os.Build
+import com.reactnativecompressor.Video.VideoCompressor.utils.StreamableVideo
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+/**
+ * Livil patch: transcode any audio Android can demux to AAC-LC in an MP4 container (.m4a),
+ * with the `moov` atom moved to the front so playback can start before the download ends.
+ *
+ * Replaces the LAME → MP3 path that shipped with the library. That path read WAV through a
+ * 16-bit-only reader (a 24-bit master was decoded as 16-bit → noise), rejected
+ * WAVE_FORMAT_EXTENSIBLE (most DAW exports), decoded nothing but MP3 for other inputs, and
+ * its stereo read had an indexing bug. MediaExtractor + MediaCodec handle WAV (8/16/24/32-bit
+ * and float), FLAC, MP3, AAC, Ogg and Opus with the platform's own codecs. AIFF has no
+ * extractor on Android, so it throws here and the caller keeps the original file.
+ */
+object AacTranscoder {
+  private const val TIMEOUT_US = 10_000L
+  private const val PCM_BYTES_PER_SAMPLE = 2
+
+  // API-31 constants, spelled out so this compiles against older compileSdks too.
+  private const val ENCODING_PCM_24BIT_PACKED = 21
+  private const val ENCODING_PCM_32BIT = 22
+
+  /**
+   * @param inputPath  a plain filesystem path (no `file://`)
+   * @param outputPath where the .m4a goes; overwritten
+   * @param bitrate    AAC bitrate in bits per second
+   * @return outputPath
+   */
+  @JvmStatic
+  fun transcode(inputPath: String, outputPath: String, bitrate: Int): String {
+    val extractor = MediaExtractor()
+    extractor.setDataSource(inputPath)
+    val trackIndex = (0 until extractor.trackCount).firstOrNull { i ->
+      extractor.getTrackFormat(i).getString(MediaFormat.KEY_MIME)?.startsWith("audio/") == true
+    } ?: run {
+      extractor.release()
+      throw IllegalArgumentException("No audio track in $inputPath")
+    }
+    extractor.selectTrack(trackIndex)
+    val inputFormat = extractor.getTrackFormat(trackIndex)
+    val inputMime = inputFormat.getString(MediaFormat.KEY_MIME)!!
+    val isRaw = inputMime == MediaFormat.MIMETYPE_AUDIO_RAW
+
+    val muxerPath = "$outputPath.muxing"
+    File(muxerPath).delete()
+    File(outputPath).delete()
+
+    var decoder: MediaCodec? = null
+    var encoder: MediaCodec? = null
+    var muxer: MediaMuxer? = null
+    var muxerStarted = false
+    try {
+      // The PCM the encoder will be fed. For a raw (WAV) source it is the track format
+      // itself; for anything else it is whatever the decoder announces on its first output.
+      var pcm: PcmFormat? = if (isRaw) PcmFormat.from(inputFormat) else null
+
+      if (!isRaw) {
+        decoder = MediaCodec.createDecoderByType(inputMime).also {
+          it.configure(inputFormat, null, null, 0)
+          it.start()
+        }
+      }
+      muxer = MediaMuxer(muxerPath, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)
+      var muxerTrack = -1
+
+      // 16-bit interleaved PCM waiting to be fed to the encoder, in frames (all channels).
+      var pending = ByteBuffer.allocate(256 * 1024).order(ByteOrder.LITTLE_ENDIAN).also { it.limit(0) }
+      var framesFed = 0L
+
+      // Raw PCM is read straight out of the extractor in chunks of this size.
+      val rawChunk: ByteBuffer? = if (isRaw) ByteBuffer.allocate(maxOf(inputFormat.maxInputSizeOr(64 * 1024), 64 * 1024)) else null
+
+      var sourceDone = false   // every sample handed to the decoder (or, raw, into `pending`)
+      var decoderDone = false  // decoder has produced its EOS (always true for raw)
+      var encoderInputDone = false
+      var encoderDone = false
+      val info = MediaCodec.BufferInfo()
+
+      fun ensureEncoder(format: PcmFormat): MediaCodec {
+        encoder?.let { return it }
+        if (format.channels !in 1..2) {
+          throw IllegalArgumentException("Unsupported channel count ${format.channels}")
+        }
+        val enc = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_AUDIO_AAC)
+        val encFormat = MediaFormat.createAudioFormat(MediaFormat.MIMETYPE_AUDIO_AAC, format.sampleRate, format.channels).apply {
+          setInteger(MediaFormat.KEY_AAC_PROFILE, MediaCodecInfo.CodecProfileLevel.AACObjectLC)
+          setInteger(MediaFormat.KEY_BIT_RATE, bitrate)
+          setInteger(MediaFormat.KEY_MAX_INPUT_SIZE, 64 * 1024)
+        }
+        enc.configure(encFormat, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+        enc.start()
+        encoder = enc
+        return enc
+      }
+
+      fun appendPcm(src: ByteBuffer, format: PcmFormat) {
+        val converted = toPcm16(src, format)
+        if (pending.remaining() + converted.remaining() > pending.capacity()) {
+          val grown = ByteBuffer.allocate(maxOf(pending.capacity() * 2, pending.remaining() + converted.remaining()))
+            .order(ByteOrder.LITTLE_ENDIAN)
+          grown.put(pending)
+          grown.flip()
+          pending = grown
+        } else {
+          pending.compact()
+          pending.flip()
+        }
+        // Append after the current contents.
+        val limit = pending.limit()
+        pending.limit(limit + converted.remaining())
+        pending.position(limit)
+        pending.put(converted)
+        pending.position(0)
+      }
+
+      while (!encoderDone) {
+        // 1. Source → decoder (or straight into `pending` for raw PCM).
+        if (!sourceDone) {
+          if (isRaw) {
+            val chunk = rawChunk!!
+            chunk.clear()
+            val read = extractor.readSampleData(chunk, 0)
+            if (read < 0) {
+              sourceDone = true
+              decoderDone = true
+            } else {
+              chunk.position(0)
+              chunk.limit(read)
+              appendPcm(chunk, pcm!!)
+              extractor.advance()
+            }
+          } else {
+            val dec = decoder!!
+            val inIndex = dec.dequeueInputBuffer(TIMEOUT_US)
+            if (inIndex >= 0) {
+              val inBuf = dec.getInputBuffer(inIndex)!!
+              val read = extractor.readSampleData(inBuf, 0)
+              if (read < 0) {
+                dec.queueInputBuffer(inIndex, 0, 0, 0L, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
+                sourceDone = true
+              } else {
+                dec.queueInputBuffer(inIndex, 0, read, extractor.sampleTime, 0)
+                extractor.advance()
+              }
+            }
+          }
+        }
+
+        // 2. Decoder → `pending`.
+        if (!isRaw && !decoderDone) {
+          val dec = decoder!!
+          val outIndex = dec.dequeueOutputBuffer(info, TIMEOUT_US)
+          when {
+            outIndex == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED -> pcm = PcmFormat.from(dec.outputFormat)
+            outIndex >= 0 -> {
+              if (pcm == null) pcm = PcmFormat.from(dec.outputFormat)
+              val outBuf = dec.getOutputBuffer(outIndex)!!
+              if (info.size > 0) {
+                outBuf.position(info.offset)
+                outBuf.limit(info.offset + info.size)
+                appendPcm(outBuf, pcm!!)
+              }
+              dec.releaseOutputBuffer(outIndex, false)
+              if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) decoderDone = true
+            }
+          }
+        }
+
+        // 3. `pending` → encoder. The encoder is created on the first PCM, when the sample
+        //    rate and channel count are finally known.
+        val format = pcm
+        if (format != null && !encoderInputDone) {
+          val enc = ensureEncoder(format)
+          val frameBytes = format.channels * PCM_BYTES_PER_SAMPLE
+          while (true) {
+            if (pending.remaining() < frameBytes && !decoderDone) break
+            val inIndex = enc.dequeueInputBuffer(if (pending.remaining() >= frameBytes) TIMEOUT_US else 0L)
+            if (inIndex < 0) break
+            val inBuf = enc.getInputBuffer(inIndex)!!
+            inBuf.clear()
+            val frames = minOf(inBuf.capacity() / frameBytes, pending.remaining() / frameBytes)
+            val ptsUs = framesFed * 1_000_000L / format.sampleRate
+            if (frames > 0) {
+              val bytes = frames * frameBytes
+              val slice = pending.duplicate()
+              slice.limit(pending.position() + bytes)
+              inBuf.put(slice)
+              pending.position(pending.position() + bytes)
+              framesFed += frames
+              enc.queueInputBuffer(inIndex, 0, bytes, ptsUs, 0)
+            } else {
+              // Nothing left and the source is finished: close the encoder's input.
+              enc.queueInputBuffer(inIndex, 0, 0, ptsUs, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
+              encoderInputDone = true
+              break
+            }
+          }
+        }
+
+        // 4. Encoder → muxer.
+        val enc = encoder
+        if (enc != null) {
+          while (true) {
+            val outIndex = enc.dequeueOutputBuffer(info, 0L)
+            if (outIndex == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+              muxerTrack = muxer.addTrack(enc.outputFormat)
+              muxer.start()
+              muxerStarted = true
+              continue
+            }
+            if (outIndex < 0) break
+            val outBuf = enc.getOutputBuffer(outIndex)!!
+            val isConfig = info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG != 0
+            if (info.size > 0 && !isConfig && muxerStarted) {
+              outBuf.position(info.offset)
+              outBuf.limit(info.offset + info.size)
+              muxer.writeSampleData(muxerTrack, outBuf, info)
+            }
+            enc.releaseOutputBuffer(outIndex, false)
+            if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) {
+              encoderDone = true
+              break
+            }
+          }
+        } else if (sourceDone && decoderDone && pending.remaining() == 0) {
+          throw IllegalStateException("Decoded no audio from $inputPath")
+        }
+      }
+    } finally {
+      try { decoder?.stop() } catch (_: Throwable) {}
+      try { decoder?.release() } catch (_: Throwable) {}
+      try { encoder?.stop() } catch (_: Throwable) {}
+      try { encoder?.release() } catch (_: Throwable) {}
+      try { if (muxerStarted) muxer?.stop() } catch (_: Throwable) {}
+      try { muxer?.release() } catch (_: Throwable) {}
+      try { extractor.release() } catch (_: Throwable) {}
+    }
+
+    val muxed = File(muxerPath)
+    if (!muxed.exists() || muxed.length() <= 32) {
+      muxed.delete()
+      throw IllegalStateException("AAC output is empty")
+    }
+    // `moov` to the front (qt-faststart), reusing the video pipeline's rewriter. If that
+    // fails for any reason the muxer's own output is still a valid .m4a — keep it.
+    val faststart = try {
+      StreamableVideo.start(`in` = muxed, out = File(outputPath))
+    } catch (_: Throwable) {
+      false
+    }
+    if (faststart && File(outputPath).length() > 32) {
+      muxed.delete()
+    } else {
+      File(outputPath).delete()
+      if (!muxed.renameTo(File(outputPath))) {
+        throw IllegalStateException("Could not place the AAC output")
+      }
+    }
+    return outputPath
+  }
+
+  private fun MediaFormat.maxInputSizeOr(fallback: Int): Int =
+    if (containsKey(MediaFormat.KEY_MAX_INPUT_SIZE)) getInteger(MediaFormat.KEY_MAX_INPUT_SIZE) else fallback
+
+  class PcmFormat(val sampleRate: Int, val channels: Int, val encoding: Int) {
+    companion object {
+      fun from(format: MediaFormat): PcmFormat {
+        val encoding = if (format.containsKey(MediaFormat.KEY_PCM_ENCODING)) {
+          format.getInteger(MediaFormat.KEY_PCM_ENCODING)
+        } else {
+          AudioFormat.ENCODING_PCM_16BIT
+        }
+        return PcmFormat(
+          sampleRate = format.getInteger(MediaFormat.KEY_SAMPLE_RATE),
+          channels = format.getInteger(MediaFormat.KEY_CHANNEL_COUNT),
+          encoding = encoding,
+        )
+      }
+    }
+  }
+
+  /** Any PCM layout the platform hands out → 16-bit signed little-endian, interleaved. */
+  private fun toPcm16(src: ByteBuffer, format: PcmFormat): ByteBuffer {
+    val input = src.slice().order(ByteOrder.LITTLE_ENDIAN)
+    return when (format.encoding) {
+      AudioFormat.ENCODING_PCM_16BIT -> input
+      AudioFormat.ENCODING_PCM_8BIT -> {
+        val out = ByteBuffer.allocate(input.remaining() * 2).order(ByteOrder.LITTLE_ENDIAN)
+        while (input.hasRemaining()) {
+          out.putShort((((input.get().toInt() and 0xFF) - 128) shl 8).toShort())
+        }
+        out.flip()
+        out
+      }
+      AudioFormat.ENCODING_PCM_FLOAT -> {
+        val count = input.remaining() / 4
+        val out = ByteBuffer.allocate(count * 2).order(ByteOrder.LITTLE_ENDIAN)
+        for (i in 0 until count) {
+          val v = input.getFloat().coerceIn(-1f, 1f)
+          out.putShort((v * 32767f).toInt().toShort())
+        }
+        out.flip()
+        out
+      }
+      ENCODING_PCM_24BIT_PACKED -> {
+        val count = input.remaining() / 3
+        val out = ByteBuffer.allocate(count * 2).order(ByteOrder.LITTLE_ENDIAN)
+        for (i in 0 until count) {
+          input.get() // low byte
+          out.put(input.get())
+          out.put(input.get())
+        }
+        out.flip()
+        out
+      }
+      ENCODING_PCM_32BIT -> {
+        val count = input.remaining() / 4
+        val out = ByteBuffer.allocate(count * 2).order(ByteOrder.LITTLE_ENDIAN)
+        for (i in 0 until count) {
+          out.putShort((input.getInt() shr 16).toShort())
+        }
+        out.flip()
+        out
+      }
+      else -> throw IllegalArgumentException("Unsupported PCM encoding ${format.encoding}")
+    }
+  }
+}
