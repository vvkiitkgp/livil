+    override fun getContentPosition(): Long = if (active) toClip(super.getContentPosition()) else super.getContentPosition()
+    override fun getBufferedPosition(): Long = if (active) toClip(super.getBufferedPosition()) else super.getBufferedPosition()
+    override fun getContentBufferedPosition(): Long = if (active) toClip(super.getContentBufferedPosition()) else super.getContentBufferedPosition()
+    override fun getDuration(): Long = if (active) clipDur else super.getDuration()
+    override fun getContentDuration(): Long = if (active) clipDur else super.getContentDuration()
+
+    override fun seekTo(positionMs: Long) = if (active) super.seekTo(positionMs + clipStart) else super.seekTo(positionMs)
+    override fun seekTo(mediaItemIndex: Int, positionMs: Long) =
