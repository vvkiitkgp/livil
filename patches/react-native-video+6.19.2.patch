+// the session publishes: position = absolute - clipStart, duration = clipEnd -
+// clipStart, and a notification scrubber seek to `p` becomes a real seek to
+// `clipStart + p`. When no clip is active it is a pure pass-through.
+class ClipForwardingPlayer(player: Player) : ForwardingPlayer(player) {
+    private val active: Boolean get() = VideoPlaybackService.currentClipActive
+    private val clipStart: Long get() = VideoPlaybackService.currentClipStartMs
+    private val clipDur: Long get() = (VideoPlaybackService.currentClipEndMs - VideoPlaybackService.currentClipStartMs).coerceAtLeast(0)
